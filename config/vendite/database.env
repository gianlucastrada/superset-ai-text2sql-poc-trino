# Impostazioni dell'AI per il database "vendite" della POC.
# deploy.ps1 le carica nella ConfigMap superset-ai-config: una riga CHIAVE=valore, # = commento.
# Per un altro database copia questa cartella, adatta i file e lancia:
#   .\scripts\deploy.ps1 -Config config\<nome-cartella>
# Le impostazioni disponibili sono descritte in superset\superset_ai\settings.py.

# Al modello solo le viste di analisi (v_vendite, v_ordini...), che contengono gia' tutte le colonne
AI_SOLO_VISTE=true
# "Oggi" per i periodi relativi: ultima data d'ordine (la tabella ordini e' nascosta, ma vale lo stesso)
AI_COLONNA_DATA=ordini.data_ordine
# Con il motore Trino lo schema si legge comunque da PostgreSQL: Trino mostra le viste come
# tabelle e potrebbe non esporre commenti e chiavi, che qui servono al modello
AI_METADATI_DA=diretto
